POSTGRES_DB=arletion
POSTGRES_USER=arletion
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://arletion:change-this-local-password@db:5432/arletion

# Server-side API proxy settings. Never prefix secrets with NEXT_PUBLIC_.
ARLETION_API_BASE_URL=http://api:8000
ARLETION_API_KEY=change-this-local-api-key
ARLETION_REQUIRE_API_KEY=true
ARLETION_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local Docker preview gate only. Replace these values before use.
ARLETION_BASIC_AUTH_USER=local-admin
ARLETION_BASIC_AUTH_PASSWORD=change-this-local-basic-auth-password
ARLETION_DEMO_MODE=false
